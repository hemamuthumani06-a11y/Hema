*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial;
}


body{
    background:#f4f4f4;
    color:#333;
}


header{
    background:#111;
    color:white;
    padding:40px;
    text-align:center;
}


nav{
    margin-top:20px;
}


nav a{
    color:white;
    text-decoration:none;
    margin:15px;
}


section{
    padding:40px;
    text-align:center;
}


.skills span{
    display:inline-block;
    background:#007bff;
    color:white;
    padding:10px 20px;
    margin:10px;
    border-radius:20px;
}


.card{
    background:white;
    margin:20px auto;
    padding:20px;
    width:60%;
    box-shadow:0 0 10px gray;
}


form{
    max-width:500px;
    margin:auto;
}


input,textarea{

    width:100%;
    padding:12px;
    margin:10px;

}


textarea{
    height:120px;
}


button{

    background:#007bff;
    color:white;
    padding:12px 30px;
    border:none;
    cursor:pointer;

}


button:hover{
    background:#0056b3;
}


footer{

    background:#111;
    color:white;
    padding:20px;
    text-align:center;

}


@media(max-width:600px){

.card{
    width:90%;
}

nav a{
    display:block;
}

}